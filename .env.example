# Copy to `.env` at repo root for local `apps/api` and `apps/worker` (gitignored).
# Requires: docker compose -f infra/compose.yaml up -d

DATABASE_URL=postgresql://pcppb:pcppb@localhost:5432/pcppb
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://pcppb:pcppb@localhost:5672

# Optional overrides
# PORT=3000
# FRONTEND_ORIGIN=http://localhost:5173

# Frontend (apps/frontend) — optional; defaults to http://localhost:3000
# VITE_API_BASE_URL=http://localhost:3000
